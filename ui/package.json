{
  "name": "tangra-sms-gw-ui",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "lint": "vue-tsc --noEmit && go-tangra-ui-check-no-legacy",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "gen:api": "openapi-typescript ../api/openapi/sms-gw.yaml -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@go-tangra/ui": "^4.3.0",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "pinia": "^4.0.3",
    "@casl/ability": "^7.0.1",
    "@casl/vue": "^3.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@module-federation/vite": "^1.22.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@playwright/test": "^1.63.0",
    "flyonui": "^2.4.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.2.4",
    "openapi-typescript": "^7.11.0",
    "@types/node": "^22.0.0"
  }
}
